# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. La URL es la base del proyecto, SIN /rest/v1.
NEXT_PUBLIC_SUPABASE_URL="https://TU_REF.supabase.co"

# Clave service_role: SECRETA. Se salta Row Level Security y solo se usa en el
# servidor (src/lib/supabase.ts). Nunca la expongas con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Clave anon (pública). La app no la necesita hoy; solo haría falta si algún día
# se usa supabase-js desde el navegador con políticas RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="genera-un-secreto-de-al-menos-32-caracteres"
NEXTAUTH_URL="http://localhost:3000"

# ─── Correo (Resend) ─────────────────────────────────────────────────────────
# Opcional. Si se deja vacía, src/lib/email/index.ts omite cada envío y deja un
# aviso en consola; el registro y los cambios de estado siguen funcionando.
RESEND_API_KEY=""
EMAIL_FROM="Fundación Esperanza <noreply@fundacionesperanza.org>"

# ─── Aplicación ──────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
APP_NAME="Fundación Esperanza"
NEXT_PUBLIC_APP_NAME="Fundación Esperanza"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
